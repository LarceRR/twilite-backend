# Twelve-factor: every knob is an env var, validated at boot by src/config/env.ts.
#
# Скопируйте этот файл рядом как .env — он подхватится автоматически:
#   Windows (cmd):  copy .env.example .env
#   PowerShell:     Copy-Item .env.example .env
#   macOS/Linux:    cp .env.example .env
#
# Приоритет: переменные окружения процесса > .env.local > .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Postgres и Redis подняты в Docker, порты проброшены на хост — сервер снаружи
# ходит к ним по localhost.
DATABASE_URL=postgres://twilite:twilite@localhost:5432/twilite
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Cloudflare R2 (S3 compatible). Leave empty to disable media uploads.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Leave empty to use the deterministic stub provider.
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini

# RevenueCat webhook shared secret. Empty disables the webhook route.
BILLING_WEBHOOK_SECRET=

SENTRY_DSN=

# How far from an occupied cell a new object may appear.
SURFACE_SPAWN_RADIUS=2
# Fading -> Settled after this many hours.
SURFACE_AGE_AFTER_HOURS=72

# ---------------------------------------------------------------------------
# Продуктовые и ресурсные лимиты (issue #38, см. docs/limits.md).
#
# Все значения ниже — production-значения и одновременно дефолты: строку можно
# удалить, поведение не изменится. Пустое или нечисловое значение — ошибка
# старта, а не фолбэк. Единицы измерения указаны в docs/limits.md.
# ---------------------------------------------------------------------------

# Аутентификация и профиль
LIMIT_EMAIL_MAX_LENGTH=254
LIMIT_PASSWORD_MIN_LENGTH=8
LIMIT_PASSWORD_MAX_LENGTH=128
LIMIT_DISPLAY_NAME_MAX_LENGTH=80
LIMIT_ACTIVE_SESSIONS_PER_USER=10
LIMIT_SIGN_IN_ATTEMPTS_PER_HOUR=20
LIMIT_SIGN_UP_PER_IP_PER_HOUR=5
LIMIT_PASSWORD_RESET_PER_EMAIL_PER_HOUR=3

# Пространства и приглашения
LIMIT_SPACES_PER_USER=3
LIMIT_SPACE_TITLE_MAX_LENGTH=80
LIMIT_MEMBERS_PER_SPACE=2
LIMIT_PENDING_INVITATIONS_PER_SPACE=1
LIMIT_INVITATIONS_PER_USER_PER_DAY=20
LIMIT_INVITATION_TTL_HOURS=72

# Моменты и поверхность
LIMIT_MOMENT_TEXT_MAX_LENGTH=2000
LIMIT_MOMENT_METADATA_MAX_BYTES=8192
LIMIT_MOMENT_METADATA_MAX_KEYS=32
LIMIT_MOMENTS_PER_SPACE_PER_DAY=200
LIMIT_OBJECTS_PER_SURFACE=500

# HTTP-граница
LIMIT_REQUEST_BODY_MAX_BYTES=262144
LIMIT_JSON_DEPTH_MAX=8
LIMIT_PAGE_SIZE_MAX=100
LIMIT_IDEMPOTENCY_KEY_MAX_LENGTH=200
LIMIT_IDEMPOTENCY_RECORD_TTL_HOURS=24

# Медиа
LIMIT_MEDIA_IMAGE_MAX_BYTES=10485760
LIMIT_MEDIA_AUDIO_MAX_BYTES=26214400
LIMIT_MEDIA_AUDIO_MAX_SECONDS=180
LIMIT_MEDIA_UPLOADS_PER_USER_PER_DAY=50
LIMIT_MEDIA_URL_TTL_SECONDS=900

# AI
LIMIT_AI_INPUT_MAX_CHARACTERS=8000
LIMIT_AI_REQUESTS_PER_USER_PER_MINUTE=3
LIMIT_AI_REQUESTS_PER_USER_PER_DAY=20
LIMIT_AI_PROVIDER_TIMEOUT_MS=20000
LIMIT_AI_DAILY_BUDGET_USD_CENTS=500

# Приватность и поддержка
LIMIT_SUPPORT_MESSAGE_MAX_LENGTH=4000
LIMIT_SUPPORT_REQUESTS_PER_USER_PER_DAY=5
LIMIT_EXPORT_REQUESTS_PER_USER_PER_DAY=2
LIMIT_DELETION_REQUESTS_PER_USER_PER_DAY=5
